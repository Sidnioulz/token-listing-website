---
/** Two-column grid for brand Cards; single column below 50rem. */
interface Props { class?: string }
const { class: className } = Astro.props;
---

<div class:list={['tl-card-grid', className]}><slot /></div>

<style>
  .tl-card-grid {
    display: grid;
    grid-template-columns: 100%;
    gap: 1rem;
  }
  .tl-card-grid > :global(*) { margin-top: 0 !important; }
  @media (min-width: 50rem) {
    .tl-card-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }
</style>
